{
  "name": "react-native-posted-sdk-monorepo",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "pnpm --filter @posted-sdk/react-native prepare",
    "test": "pnpm --filter @posted-sdk/react-native test",
    "typecheck": "pnpm --filter @posted-sdk/react-native typecheck",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "release": "pnpm --filter @posted-sdk/react-native release"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/compat": "^1.2.7",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@evilmartians/lefthook": "^1.5.0",
    "@react-native/eslint-config": "^0.78.0",
    "commitlint": "^19.6.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "eslint-plugin-prettier": "^5.2.3",
    "prettier": "^3.0.3"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "version": "1.0.0"
}
