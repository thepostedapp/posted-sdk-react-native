{
  "name": "@posted-sdk/react-native",
  "version": "1.0.0",
  "description": "Reports app installs to Posted for ad attribution. React Native package.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc",
    "docs": "typedoc",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "prepack": "cp ../../README.md README.md && cp ../../LICENSE LICENSE",
    "postpack": "rm README.md LICENSE",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thepostedapp/posted-sdk-react-native.git",
    "directory": "packages/react-native-posted-sdk"
  },
  "author": "postedapp <yuriy@postedapp.com>",
  "bugs": {
    "url": "https://github.com/thepostedapp/posted-sdk-react-native/issues"
  },
  "homepage": "https://github.com/thepostedapp/posted-sdk-react-native#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native/babel-preset": "0.83.4",
    "@release-it/conventional-changelog": "^9.0.2",
    "@types/jest": "^29.5.5",
    "del-cli": "^5.1.0",
    "expo-application": "~55.0.19",
    "expo-constants": "~55.0.11",
    "expo-device": "~55.0.12",
    "expo-localization": "~55.0.19",
    "jest": "^29.7.0",
    "react": "19.2.0",
    "react-native": "0.83.4",
    "react-native-builder-bob": "0.40.13",
    "react-native-device-info": "^15.0.2",
    "release-it": "^17.10.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=2.0.0",
    "expo-application": ">=6.1.5",
    "expo-constants": ">=17.1.7",
    "expo-device": ">=7.0.0",
    "expo-localization": ">=15.0.0",
    "react-native": ">=0.72",
    "react-native-device-info": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "expo-application": {
      "optional": true
    },
    "expo-constants": {
      "optional": true
    },
    "expo-localization": {
      "optional": true
    },
    "expo-device": {
      "optional": true
    },
    "react-native-device-info": {
      "optional": true
    }
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ]
  },
  "release-it": {
    "hooks": {
      "after:bump": "node -e \"const fs=require('fs'); const f='./src/version.ts'; const c=fs.readFileSync(f,'utf8').replace(/version = [\\\"'].*[\\\"'];/, 'version = \\\"${version}\\\";'); fs.writeFileSync(f,c);\""
    },
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "js",
    "type": "library",
    "version": "0.53.0"
  }
}
